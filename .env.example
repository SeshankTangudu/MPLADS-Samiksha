# ==============================================================================
# MPLADS Samiksha - Environment Configuration Template (.env.example)
# Copy this file to .env and configure for local environment.
# DO NOT commit .env with real credentials/secrets to version control.
# ==============================================================================

# Database Connection (SQLite primary for MVP)
DATABASE_URL=sqlite:///data/processed/mplads.db

# Backend API Configuration
PORT=8000
HOST=127.0.0.1
ALLOWED_ORIGINS=http://localhost:5173

# Application Environment (development, testing, production)
ENVIRONMENT=development

# Frontend Configuration (Vite)
# VITE_API_BASE_URL=http://localhost:8000/api
